# Resend (https://resend.com) API key used by src/pages/api/submit-forecast.ts
# to email new forecast submissions.
RESEND_API_KEY=

# Email address that receives forecast submissions.
FORECAST_NOTIFY_TO=alo@webinarops.io

# "From" address for outbound notification emails. Must be on a domain
# verified in your Resend account.
FORECAST_NOTIFY_FROM=WebinarOps Forecast <forecast@updates.webinarops.io>
